APP_NAME="AI Company Brain - Knowledge Service"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

CORS_ORIGINS=["http://localhost:8000","http://localhost:5173"]

CHROMA_PATH=data/chroma
CHROMA_DEFAULT_COLLECTION=company_knowledge
CHROMA_COLLECTION=company_knowledge

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Drive OAuth (downloaded JSON from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=secrets/credentials.json
GOOGLE_TOKEN_PATH=secrets/token.json
